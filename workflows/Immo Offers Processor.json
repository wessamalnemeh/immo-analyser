      "parameters": {
        "chatId": "-1004492890322",
        "text": "=🏠 <b>Neues Immobilienangebot!</b>\n━━━━━━━━━━━━━━━━━━━━━\n\n📍 <b>Lage</b>\nStadt: {{ $json.location.city }}, {{ $json.location.district }}\nPLZ: {{ $json.location.zip_code }} · {{ $json.location.state }}\n\n🏗️ <b>Objektdetails</b>\nTyp: {{ $json.listing.property_type }}\nWohnfläche: {{ $json.property.living_area_m2 }} m²\nZimmer: {{ $json.property.rooms }} ({{ $json.property.bedrooms }} Schlafzimmer · {{ $json.property.bathrooms }} Bad)\nEtage: {{ $json.property.floor }} von {{ $json.property.total_floors }}\nBaujahr: {{ $json.property.year_built }} · Saniert: {{ $json.property.last_renovation_year }}\nZustand: {{ $json.property.condition }}\n\n✅ <b>Ausstattung</b>\nBalkon: {{ $json.property.has_balcony ? '✅' : '❌' }}\nTerrasse: {{ $json.property.has_terrace ? '✅' : '❌' }}\nGarten: {{ $json.property.has_garden ? '✅' : '❌' }}\nKeller: {{ $json.property.has_cellar ? '✅' : '❌' }}\nAufzug: {{ $json.property.has_elevator ? '✅' : '❌' }}\nStellplatz: {{ $json.property.parking_type ?? 'Kein' }}\n\n💶 <b>Finanzen</b>\nKaufpreis: <b>{{ $json.financials.purchase_price_eur }}€</b>\nPreis/m²: {{ $json.financials.price_per_m2_eur }}€\nKaltmiete: {{ $json.financials.monthly_cold_rent_eur ?? 'k.A.' }}€/mo\nWarmmiete: {{ $json.financials.monthly_warm_rent_eur ?? 'k.A.' }}€/mo\nHausgeld: {{ $json.financials.monthly_hoa_fee_eur }}€/Monat\nBruttorendite: {{ $json.financials.gross_yield_percent ?? 'k.A.' }}%\nVermietet: {{ $json.financials.is_currently_rented ? '✅ Ja' : '❌ Nein' }}\n\n⚡ <b>Energie</b>\nEnergieklasse: {{ $json.energy.energy_class }}\nVerbrauch: {{ $json.energy.energy_consumption_kwh_m2 }} kWh/m²\nHeizung: {{ $json.energy.heating_type }}\nAusweis: {{ $json.energy.energy_certificate_type }}\n\n📋 <b>Transaktion</b>\nProvision: {{ $json.transaction.commission_buyer_percent }}% ({{ $json.transaction.commission_buyer_eur ?? 'k.A.' }}€)\nVerfügbar ab: {{ $json.transaction.available_from }}\n\n🔗 <a href=\"{{ $json.listing.url }}\">Zum Inserat</a>\n━━━━━━━━━━━━━━━━━━━━━",
