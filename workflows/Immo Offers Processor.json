      "parameters": {
        "jsCode": "// Get the text from Anthropic's response structure\nconst raw = $input.first().json.content[0].text;\n\n// Strip markdown code block if present (```json ... ```)\nconst cleaned = raw\n  .replace(/^```json\\s*/i, '')\n  .replace(/^```\\s*/i, '')\n  .replace(/```\\s*$/i, '')\n  .trim();\n\n// Parse JSON\nconst parsed = JSON.parse(cleaned);\n\nreturn [{ json: parsed }];"
      },
