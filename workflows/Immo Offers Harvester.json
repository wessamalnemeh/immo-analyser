    {
      "parameters": {
        "jsCode": "const results = [];\n\nconst grab = (block, label) => {\n  const m = block.match(new RegExp('^\\\\s*' + label + '\\\\s*:\\\\s*(.+)$', 'mi'));\n  return m ? m[1].trim() : null;\n};\n\nconst toNum = (s) => {\n  if (!s) return null;\n  const m = s.replace(/\\./g, '').replace(',', '.').match(/-?\\d+(\\.\\d+)?/);\n  return m ? parseFloat(m[0]) : null;\n};\n\nconst DASH_FOOTER = /Alle Angebote ansehen|<!--\\s*FOOTER START/i;\n\n$input.all().forEach((item, idx) => {\n  const d = item.json;\n  const raw = d.text ?? d.textPlain ?? d.body ?? d.snippet ?? '';\n\n  let text = String(raw)\n    .replace(/\\\\r\\\\n|\\\\n/g, '\\n')\n    .replace(/\\r\\n/g, '\\n')\n    .replace(/&nbsp;/g, ' ');\n\n  const cut = text.search(DASH_FOOTER);\n  if (cut > -1) text = text.slice(0, cut);\n\n  for (const chunk of text.split(/\\n(?=\\s*Titel\\s*:)/i)) {\n    if (!/^\\s*Titel\\s*:/i.test(chunk)) continue;\n\n    const link = (chunk.match(/https?:\\/\\/\\S*expose\\/\\d+\\S*/i) || [null])[0];\n    const exposeId = link ? (link.match(/expose\\/(\\d+)/) || [])[1] : null;\n    if (!exposeId) continue;\n\n    results.push({\n      json: {\n        expose_id: exposeId,\n        titel: grab(chunk, 'Titel'),\n        link,\n        addresse: grab(chunk, 'Adresse'),\n        kaufpreis: grab(chunk, 'Kaufpreis'),\n        wohnflaeche: grab(chunk, 'Wohnfl(?:ä|ae)che'),\n        zimmer: toNum(grab(chunk, 'Zimmer')),\n        mail_id: d.id ?? null,\n        mail_subject: d.subject ?? null,\n        mail_date: d.date ?? null,\n      },\n      pairedItem: { item: idx },\n    });\n  }\n});\n\nreturn results;"
      },
